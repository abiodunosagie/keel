          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode d'énergie de macOS. Haute puissance n'existe que sur certains MacBook Pro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo de energia do macOS. Alto desempenho só existe em alguns MacBook Pro."
          }
        }
      }
    },
    "The screen backlight takes %@ (%lld%%). Lower brightness saves the most.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bildschirmbeleuchtung braucht %@ (%lld %%). Weniger Helligkeit spart am meisten."
