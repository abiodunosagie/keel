    "The Keel mark filling to your level, state symbols, an iPhone-style battery with the level inside, or a tiny graph of the last half hour.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Keel-Zeichen, gefüllt bis zu deinem Stand, Statussymbole, ein Akku im iPhone-Stil mit dem Stand darin oder ein kleines Diagramm der letzten halben Stunde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La marca Keel llenándose hasta tu nivel, símbolos de estado, una batería al estilo iPhone con el nivel dentro o un pequeño gráfico de la última media hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La marque Keel remplie jusqu'à votre niveau, symboles d'état, une batterie façon iPhone avec le niveau à l'intérieur, ou un petit graphique de la dernière demi-heure."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A marca Keel a encher até ao seu nível, símbolos de estado, uma bateria ao estilo iPhone com o nível lá dentro, ou um pequeno gráfico da última meia hora."
          }
        }
      }
    },
    "The Mac stays awake until the cycle ends. Unplugging during a charging step stops it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac bleibt bis zum Ende wach. Abstecken während eines Ladeschritts stoppt ihn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac sigue despierto hasta que termine el ciclo. Desconectar durante un paso de carga lo detiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac reste éveillé jusqu'à la fin du cycle. Débrancher pendant une étape de charge l'arrête."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac fica acordado até o ciclo terminar. Desligar durante um passo de carga para-o."
          }
        }
      }
    },
