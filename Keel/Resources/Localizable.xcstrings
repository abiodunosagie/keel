    "Keel charging sessions": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keel-Ladevorgänge"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiones de carga de Keel"
          }
        },
        "fr": {
          "stringUnit": {
