    "Pause charging when the battery is hotter than the limit. Checked again every %lld minutes. macOS can only pause charging above %lld%%.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert das Laden, wenn der Akku heißer als das Limit ist. Alle %lld Minuten erneut geprüft. macOS kann das Laden nur über %lld %% pausieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa la carga cuando la batería supera el límite de temperatura. Se revisa cada %lld minutos. macOS solo puede pausar la carga por encima del %lld%%."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met la charge en pause quand la batterie dépasse la limite de température. Revérifié toutes les %lld minutes. macOS ne peut suspendre la charge qu'au-dessus de %lld %%."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar o carregamento quando a bateria estiver mais quente do que o limite. Verificado de novo a cada %lld minutos. O macOS só consegue pausar o carregamento acima de %lld%%."
          }
        }
      }
    },
