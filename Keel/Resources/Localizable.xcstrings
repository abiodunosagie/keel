    "macOS sometimes charges to 100% to recalibrate its battery gauge. It goes back to the limit afterwards.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS lädt manchmal auf 100%, um seine Akkuanzeige neu zu kalibrieren. Danach geht es zurück zum Limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A veces macOS carga al 100% para recalibrar el indicador de batería. Después vuelve al límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS charge parfois à 100% pour recalibrer sa jauge. Il revient ensuite à la limite."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Por vezes o macOS carrega até 100% para recalibrar o indicador da bateria. Depois volta ao limite."
