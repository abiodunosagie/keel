    "Run actions at set times. A task missed while the Mac sleeps can run when it wakes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktionen zu festen Zeiten. Eine im Ruhezustand verpasste Aufgabe kann beim Aufwachen laufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta acciones a horas fijas. Una tarea perdida mientras el Mac duerme puede ejecutarse al despertar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez des actions à heure fixe. Une tâche manquée pendant la veille peut s'exécuter au réveil."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute ações a horas definidas. Uma tarefa falhada com o Mac a dormir pode correr quando acordar."
          }
        }
      }
    },
