    "When Keel starts and the battery is well above your limit, for example after charging while switched off.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Keel startet und der Akku deutlich über deinem Limit liegt, etwa nach dem Laden im ausgeschalteten Zustand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando Keel se inicia y la batería está muy por encima de tu límite, por ejemplo tras cargar con el Mac apagado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand Keel démarre et que la batterie dépasse nettement votre limite, par exemple après une charge Mac éteint."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o Keel arranca e a bateria está bem acima do seu limite, por exemplo após carregar com o Mac desligado."
          }
        }
      }
    },
    "When the battery is above the limit on the charger, run on battery until it gets there. Off: stay at the current level.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liegt der Akku am Netzteil über dem Limit, läuft der Mac auf Akku, bis es erreicht ist. Aus: auf dem aktuellen Stand bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando la batería supera el límite con el cargador, funciona con batería hasta llegar a él. Desactivado: se queda en el nivel actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand la batterie dépasse la limite sur secteur, fonctionner sur batterie jusqu'à l'atteindre. Désactivé : rester au niveau actuel."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando a bateria está acima do limite com o carregador, funciona com bateria até lá chegar. Desligado: fica no nível atual."
          }
        }
      }
    },
