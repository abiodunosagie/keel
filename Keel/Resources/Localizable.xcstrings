    "Keel: green at the limit, amber while charging or discharging. Only on Macs with a MagSafe port.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keel: grün am Limit, orange beim Laden oder Entladen. Nur bei Macs mit MagSafe-Anschluss."
          }
