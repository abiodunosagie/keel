    },
    "This Mac has no built-in charge limit. It needs macOS 26.4 or later on Apple silicon.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac hat kein eingebautes Ladelimit. Nötig ist macOS 26.4 oder neuer auf Apple Silicon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no tiene límite de carga integrado. Necesita macOS 26.4 o posterior en Apple silicon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac n'a pas de limite de charge intégrée. Il faut macOS 26.4 ou ultérieur sur Apple silicon."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não tem limite de carga integrado. É preciso macOS 26.4 ou posterior num Mac com Apple silicon."
          }
        }
      }
    },
    "Three quick questions, and Keel suggests settings for how you use your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei kurze Fragen, und Keel schlägt Einstellungen für deine Nutzung vor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tres preguntas rápidas y Keel sugiere ajustes para cómo usas tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois questions rapides, et Keel suggère des réglages adaptés à votre usage."
