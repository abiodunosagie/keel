    "Needed for Calibration, the MagSafe light and power modes. It only switches the charger, the light, sleep and the power mode, and undoes the first three when Keel quits.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nötig für Kalibrierung, MagSafe-Licht und Energiemodi. Er schaltet nur Netzteil, Licht, Ruhezustand und Energiemodus und setzt die ersten drei beim Beenden von Keel zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesario para la calibración, la luz MagSafe y los modos de energía. Solo cambia el cargador, la luz, el reposo y el modo de energía, y deshace los tres primeros al cerrar Keel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire pour la calibration, le voyant MagSafe et les modes d'énergie. Il ne touche qu'au chargeur, au voyant, à la veille et au mode d'énergie, et rétablit les trois premiers quand Keel se ferme."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Necessário para a calibração, a luz MagSafe e os modos de energia. Só altera o carregador, a luz, o repouso e o modo de energia, e desfaz os três primeiros quando o Keel fecha."
          }
        }
      }
    },
