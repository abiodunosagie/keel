            "state": "translated",
            "value": "A temperatura da bateria."
          }
        }
      }
    },
    "The charge limit stays on unless you turned that off under Charge.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ladelimit bleibt, außer du hast das unter Laden ausgeschaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El límite de carga sigue activo salvo que lo desactivaras en Carga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite de charge reste active, sauf si vous l'avez désactivé dans Charge."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite de carga mantém-se, a não ser que o tenha desligado em Carga."
          }
        }
      }
    },
    "The charger": {
