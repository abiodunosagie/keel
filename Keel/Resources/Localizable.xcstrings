    "%lld%% on %@. Changing it here applies until you switch networks.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld %% im Netz %@. Eine Änderung hier gilt bis zum Netzwechsel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%% en %@. Un cambio aquí se aplica hasta que cambies de red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld %% sur %@. Une modification ici s'applique jusqu'au changement de réseau."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%% em %@. Uma alteração aqui vale até mudar de rede."
          }
        }
      }
    },
    "%lld%% on the chip is 100%% in macOS right now, so nothing stops charging. Lower the limit.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld %% auf dem Chip sind gerade 100 %% in macOS, also stoppt nichts das Laden. Senke das Limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%% en el chip equivale ahora al 100%% en macOS, así que nada detiene la carga. Baja el límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld %% sur la puce correspond à 100 %% dans macOS en ce moment, donc rien n'arrête la charge. Baissez la limite."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%% no chip corresponde agora a 100%% no macOS, por isso nada para o carregamento. Baixe o limite."
          }
        }
      }
    },
