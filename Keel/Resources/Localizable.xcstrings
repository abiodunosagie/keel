    },
    "The battery is at %@. Charging resumes when it cools.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Akku hat %@. Das Laden geht weiter, wenn er abkühlt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La batería está a %@. La carga se reanuda cuando se enfríe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La batterie est à %@. La charge reprendra quand elle refroidira."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A bateria está a %@. O carregamento retoma quando arrefecer."
          }
        }
      }
    },
    "The battery is at %@. Heat ages it faster; give the Mac some air or a lighter load.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Akku hat %@. Hitze lässt ihn schneller altern; gib dem Mac Luft oder weniger Last."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La batería está a %@. El calor la envejece antes; dale aire al Mac o menos carga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La batterie est à %@. La chaleur l'use plus vite ; aérez le Mac ou allégez la charge."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A bateria está a %@. O calor envelhece-a mais depressa; dê ar ao Mac ou alivie a carga."
          }
        }
      }
    },
    "The battery is held at %lld%%. The Mac now runs on the charger.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Akku wird bei %lld %% gehalten. Der Mac läuft jetzt über das Netzteil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La batería se mantiene al %lld%%. El Mac funciona ahora con el cargador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La batterie est maintenue à %lld %%. Le Mac fonctionne maintenant sur secteur."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A bateria está mantida em %lld%%. O Mac funciona agora com o carregador."
          }
        }
      }
    },
    "The battery is warm (%@), which drains and ages it faster.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Akku ist warm (%@), das leert ihn und lässt ihn schneller altern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La batería está caliente (%@), lo que la gasta y envejece antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La batterie est chaude (%@), ce qui la vide et l'use plus vite."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A bateria está quente (%@), o que a gasta e envelhece mais depressa."
          }
        }
      }
    },
    "The battery level Keel uses: the hardware percentage when that setting is on, otherwise the macOS one.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Akkustand, den Keel nutzt: der Hardware-Wert bei aktivierter Option, sonst der von macOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nivel que usa Keel: el porcentaje del hardware con ese ajuste activado; si no, el de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le niveau utilisé par Keel : le pourcentage matériel si ce réglage est activé, sinon celui de macOS."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O nível que o Keel usa: a percentagem de hardware com essa opção ligada, caso contrário a do macOS."
          }
        }
      }
    },
    "The battery level next to the icon.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
