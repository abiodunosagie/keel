    "It's at %lld%%, above your %lld%% limit, probably from charging while Keel wasn't running. Automatic Discharge brings it down on the charger.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er steht bei %lld %%, über deinem Limit von %lld %%, vermutlich vom Laden ohne Keel. Automatisches Entladen senkt ihn am Netzteil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está al %lld%%, por encima de tu límite del %lld%%, probablemente por cargar con Keel cerrado. La Descarga automática la baja con el cargador conectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle est à %lld %%, au-dessus de votre limite de %lld %%, sans doute chargée pendant que Keel ne tournait pas. La Décharge automatique la fait redescendre sur secteur."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Está a %lld%%, acima do seu limite de %lld%%, provavelmente por ter carregado com o Keel fechado. A Descarga automática baixa-a com o carregador ligado."
          }
        }
      }
    },
    "It's at %lld%%, above your %lld%% limit, probably from charging while Keel wasn't running. Use Discharge to bring it down.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er steht bei %lld %%, über deinem Limit von %lld %%, vermutlich vom Laden ohne Keel. Nutze Entladen, um ihn zu senken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está al %lld%%, por encima de tu límite del %lld%%, probablemente por cargar con Keel cerrado. Usa Descargar para bajarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle est à %lld %%, au-dessus de votre limite de %lld %%, sans doute chargée pendant que Keel ne tournait pas. Utilisez Décharger pour la faire descendre."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Está a %lld%%, acima do seu limite de %lld%%, provavelmente por ter carregado com o Keel fechado. Use Descarregar para a baixar."
          }
        }
      }
    },
    "Joining a listed network sets its limit; other networks use your normal limit.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gelistetes Netz setzt sein Limit; andere Netze nutzen dein normales Limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al unirte a una red de la lista se aplica su límite; las demás usan tu límite normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoindre un réseau de la liste applique sa limite ; les autres réseaux utilisent votre limite habituelle."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao entrar numa rede da lista aplica-se o limite dela; as outras redes usam o limite normal."
          }
        }
      }
    },
