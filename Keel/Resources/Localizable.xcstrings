    "Puts back the charge limit macOS had before Keel, removes the helper and the login item, and moves Keel to the Trash.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt das Ladelimit von macOS vor Keel wieder her, entfernt Helper und Anmeldeobjekt und legt Keel in den Papierkorb."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura el límite de carga que macOS tenía antes de Keel, elimina el helper y el ítem de inicio, y mueve Keel a la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablit la limite de charge de macOS d'avant Keel, supprime le helper et l'ouverture automatique, et place Keel dans la Corbeille."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Repõe o limite de carga que o macOS tinha antes do Keel, remove o helper e o elemento de início de sessão, e move o Keel para o Lixo."
