    "%@ can't keep up with the Mac's %@, so the battery is draining.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ schafft die %@ des Mac nicht, deshalb entlädt sich der Akku."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no da abasto con los %@ del Mac, así que la batería se está gastando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne suit pas les %@ du Mac, la batterie se vide donc."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não acompanha os %@ do Mac, por isso a bateria está a descarregar."
