{
  "sourceLanguage": "en",
  "strings": {
    " A forecast appears after two weeks of daily records.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Eine Prognose erscheint nach zwei Wochen täglicher Messungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " La previsión aparece tras dos semanas de registros diarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Une prévision apparaît après deux semaines de relevés quotidiens."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": " A previsão aparece após duas semanas de registos diários."
          }
        }
      }
    },
    " About %@ left at this rate.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Bei diesem Verbrauch noch etwa %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Quedan unos %@ a este ritmo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Environ %@ restantes à ce rythme."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": " Restam cerca de %@ a este ritmo."
          }
        }
      }
    },
    " At this rate it reaches 80%%, Apple's service mark, around %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " So erreicht sie etwa %@ 80 %%, Apples Service-Grenze."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " A este ritmo llegará al 80%%, el límite de servicio de Apple, hacia %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " À ce rythme, elle atteindra 80 %%, le seuil de service d'Apple, vers %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": " A este ritmo chega a 80%%, o limite de assistência da Apple, por volta de %@."
          }
        }
      }
    },
    " It hasn't dropped over the recorded period.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Im erfassten Zeitraum ist sie nicht gesunken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " No ha bajado en el periodo registrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Elle n'a pas baissé sur la période enregistrée."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": " Não desceu no período registado."
          }
        }
      }
    },
