    "Higher than the battery: it charges. Lower: charging stops (and with Automatic Discharge on, it runs down to the limit).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über dem Akkustand: Er lädt. Darunter: Laden stoppt (und mit automatischem Entladen geht er aufs Limit runter)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por encima de la batería: carga. Por debajo: la carga se detiene (y con la Descarga automática, baja hasta el límite)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au-dessus de la batterie : elle charge. En dessous : la charge s'arrête (et avec la Décharge automatique, elle descend jusqu'à la limite)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Acima da bateria: carrega. Abaixo: o carregamento para (e com a Descarga automática, desce até ao limite)."
          }
        }
      }
    },
