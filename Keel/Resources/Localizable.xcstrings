    "Holding at 100%% until %@. The Mac stays awake until the cycle ends.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte bei 100 %% bis %@. Der Mac bleibt wach, bis der Zyklus endet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Manteniendo al 100%% hasta las %@. El Mac sigue despierto hasta que termine el ciclo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintien à 100 %% jusqu'à %@. Le Mac reste éveillé jusqu'à la fin du cycle."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A manter em 100%% até às %@. O Mac fica acordado até o ciclo terminar."
          }
        }
      }
    },
