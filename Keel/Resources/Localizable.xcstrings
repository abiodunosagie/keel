    "macOS hides Wi-Fi names without location access. Allow Keel in System Settings > Privacy & Security > Location Services.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS verbirgt WLAN-Namen ohne Ortungszugriff. Erlaube Keel unter Systemeinstellungen > Datenschutz & Sicherheit > Ortungsdienste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS oculta los nombres Wi-Fi sin acceso a la ubicación. Permite Keel en Ajustes del Sistema > Privacidad y seguridad > Localización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS masque les noms Wi-Fi sans accès à la localisation. Autorisez Keel dans Réglages Système > Confidentialité et sécurité > Service de localisation."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS esconde os nomes das redes Wi-Fi sem acesso à localização. Permita o Keel em Definições do Sistema > Privacidade e segurança > Serviços de localização."
          }
        }
      }
    },
