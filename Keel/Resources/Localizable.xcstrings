    "macOS didn't accept the charge limit. Keel will try again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat das Ladelimit nicht übernommen. Keel versucht es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no aceptó el límite de carga. Keel lo intentará de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n'a pas accepté la limite de charge. Keel va réessayer."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS não aceitou o limite de carga. O Keel vai tentar de novo."
          }
        }
      }
    },
    "macOS didn't allow changing the login item. Try again from System Settings > General > Login Items.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat die Änderung nicht erlaubt. Versuche es unter Systemeinstellungen > Allgemein > Anmeldeobjekte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no permitió cambiar el ítem de inicio. Inténtalo en Ajustes del Sistema > General > Ítems de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n'a pas autorisé la modification. Réessayez depuis Réglages Système > Général > Ouverture."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS não permitiu alterar o elemento de início de sessão. Tente em Definições do Sistema > Geral > Elementos de início de sessão."
          }
        }
      }
    },
    "macOS didn't install the helper. Try again, or check System Settings > General > Login Items.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat den Helper nicht installiert. Versuche es erneut oder prüfe Systemeinstellungen > Allgemein > Anmeldeobjekte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no instaló el helper. Inténtalo de nuevo o revisa Ajustes del Sistema > General > Ítems de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n'a pas installé le helper. Réessayez ou vérifiez Réglages Système > Général > Ouverture."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS não instalou o helper. Tente de novo ou veja Definições do Sistema > Geral > Elementos de início de sessão."
          }
        }
      }
    },
    "macOS didn't remove Keel Helper, so Keel stays installed. Try again, or switch it off in System Settings > General > Login Items.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat Keel Helper nicht entfernt, daher bleibt Keel installiert. Versuche es erneut oder schalte ihn unter Systemeinstellungen > Allgemein > Anmeldeobjekte aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no eliminó Keel Helper, así que Keel sigue instalado. Inténtalo de nuevo o desactívalo en Ajustes del Sistema > General > Ítems de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS n'a pas supprimé Keel Helper, Keel reste donc installé. Réessayez ou désactivez-le dans Réglages Système > Général > Ouverture."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS não removeu o Keel Helper, por isso o Keel fica instalado. Tente de novo ou desligue-o em Definições do Sistema > Geral > Elementos de início de sessão."
          }
        }
      }
    },
