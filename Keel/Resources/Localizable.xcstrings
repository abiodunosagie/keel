    "A charger is plugged in but isn't powering the Mac. Try another cable, port or charger.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Netzteil ist angeschlossen, versorgt den Mac aber nicht. Probiere ein anderes Kabel, einen anderen Anschluss oder ein anderes Netzteil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un cargador conectado, pero no alimenta el Mac. Prueba otro cable, puerto o cargador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chargeur est branché mais n'alimente pas le Mac. Essayez un autre câble, port ou chargeur."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Há um carregador ligado, mas não está a alimentar o Mac. Experimente outro cabo, porta ou carregador."
          }
        }
      }
    },
    "A full battery for long days, back to the limit after you unplug.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Voller Akku für lange Tage, danach zurück zum Limit, sobald du absteckst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Batería llena para días largos; vuelve al límite al desconectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une batterie pleine pour les longues journées, retour à la limite après débranchement."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Bateria cheia para dias longos; volta ao limite depois de desligar."
          }
        }
      }
    },
    "A full cycle keeps the battery's percentage reading accurate. Last run %lld days ago.": {
