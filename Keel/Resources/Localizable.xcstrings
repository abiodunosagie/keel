    "While Keel keeps the Mac awake (calibration, keep awake until the limit).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange Keel den Mac wach hält (Kalibrierung, wach bis zum Limit)."
          }
